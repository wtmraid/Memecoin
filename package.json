{
  "name": "memecoin-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Solana memecoin scanner and signal bot (scanner + signals only; no live trading)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "telegram:login": "tsx scripts/telegram-login.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "pino": "^9.14.0",
    "telegram": "^2.26.22",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
