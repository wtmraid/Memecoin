# ---------- Solana RPC (Phase 1) ----------
# Helius free plan works for Phase 1 (standard WebSockets + RPC + DAS). https://dashboard.helius.dev
HELIUS_API_KEY=
# Or any other RPC (overrides Helius). DAS holder counts are Helius-only.
# SOLANA_RPC_URL=https://...
# SOLANA_WS_URL=wss://...

# ---------- Market data ----------
# DexScreener + GeckoTerminal need no keys.
# Optional Birdeye key (free Standard plan = 1 rps): https://bds.birdeye.so
BIRDEYE_API_KEY=

# ---------- Feature switches ----------
ENABLE_ONCHAIN=true
# Live pump.fun trades power the bundler/sniper/dev checks and SNIPE momentum. Turning this off
# does NOT save Helius credits (the stream is received either way) — keep it on.
ENABLE_PUMPFUN_TRADES=true
ENABLE_DEXSCREENER=true
ENABLE_GECKOTERMINAL=true
ENABLE_REDDIT=false
ENABLE_TELEGRAM=false
ENABLE_SMART_WALLETS=false

# ---------- Signals (Phase 2+3) ----------
ENABLE_SIGNALS=true
# GMGN OpenAPI key — the exact "Core Metrics" GMGN shows (bundler, insiders, phishing,
# rug ratio, dev migrated…). Generate at https://gmgn.ai/ai  (free plan ≈ 5 req/s).
# GMGN's API is IPv4-only: if you get 401/403 with a valid key, disable IPv6 on the VPS.
GMGN_API_KEY=
# Jupiter Developer Platform key for the honeypot/sell test: https://developers.jup.ag
# (free = 1 rps; keyless works at 0.5 rps)
JUPITER_API_KEY=
ENABLE_RUGCHECK=true

# ---------- Alerts ----------
# Create a bot with @BotFather. Leave TELEGRAM_ALERT_CHAT_ID empty at first: message the bot
# and it replies with your chat id. Then set it and restart.
# The bot also answers in that chat: paste any CA (or /scan CA) for a full scan; /open lists tracked signals.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Optional
DISCORD_WEBHOOK_URL=

# ---------- Smart money ----------
# Comma-separated wallet addresses to watch for early buys (one WS subscription each).
SMART_WALLETS=

# ---------- Reddit (official Data API, non-commercial free tier) ----------
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:memecoin-scanner:0.1.0 (by /u/your_username)

# ---------- Telegram (MTProto user client, read-only) ----------
# Your own api_id/api_hash from https://my.telegram.org — never a public/shared one.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: npm run telegram:login   (treat it like a password)
TELEGRAM_SESSION=
# Comma-separated @usernames of channels/groups the account has joined
TELEGRAM_CHANNELS=
# Subset of the above whose posts count as KOL / caller signals
# (e.g. a pump.fun volume-signal channel you follow)
TELEGRAM_KOL_CHANNELS=

# ---------- X / Twitter (off by default — pay-per-use, see docs/RESEARCH.md) ----------
# off | official | twitterapi_io
X_PROVIDER=off
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
# Comma-separated handles without @
KOL_X_HANDLES=

# ---------- Storage / misc ----------
DB_PATH=./data/scanner.db
CONFIG_PATH=./config/default.json
LOG_LEVEL=info
LOG_PRETTY=false
